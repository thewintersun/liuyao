# ========== LLM 供应商 ==========
# 默认供应商，可选 deepseek / glm
# 管理后台「系统配置 → AI 供应商」的设置优先于这里，改后台不需要重启
LLM_PROVIDER=deepseek

# DeepSeek LLM API
DEEPSEEK_API_KEY=your_deepseek_api_key
DEEPSEEK_API_BASE=https://api.deepseek.com

# 智谱 GLM API
GLM_API_KEY=your_glm_api_key
# Coding Plan 端点（用包月额度）。智谱声明该端点仅限编码场景，
# 若要用于普通对话请改为通用端点：https://open.bigmodel.cn/api/paas/v4
GLM_API_BASE=https://open.bigmodel.cn/api/coding/paas/v4
# Coding Plan 可用模型视套餐而定：glm-4.5 / glm-4.6 / glm-4.7 / glm-5 / glm-5.1
GLM_DEFAULT_MODEL=glm-4.6
# 推理模式，token 计入 max_tokens 预算；关闭填 false
GLM_THINKING_ENABLED=true

# 邮件发送配置
EMAIL_ADDRESS=your_email@example.com
EMAIL_PASSWORD=your_email_password

# 管理员通知邮箱
ADMIN_EMAIL=admin@example.com

# Flask 密钥
FLASK_SECRET_KEY=your_flask_secret_key

# JWT 密钥（必填，否则启动报错）
JWT_SECRET=your_jwt_secret

# 站点地址（用于密码重置邮件中的链接，部署时必须改为实际域名）
# 例如：SITE_URL=https://your-domain.com
SITE_URL=http://localhost:9001

# 是否部署在可信反向代理（如 Nginx）后面
# 设为 true 时才信任 X-Forwarded-For / X-Real-IP 头获取真实客户端 IP
# 生产环境（Nginx 反代）必须设为 true，否则日志/限流看到的 IP 都是 127.0.0.1
# 本地直连开发时保持 false（防止伪造头绕过 IP 限流）
BEHIND_PROXY=false
